---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { isPublished } from '../lib/content';

const tools = (await getCollection('articles', (e) => isPublished(e) && e.data.type === 'أداة_AI')).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);
---
<BaseLayout title="أدوات AI">
  <h1 class="text-2xl font-bold mb-6">أدوات الذكاء الاصطناعي</h1>
  {tools.length === 0 ? (
    <p class="text-neutral-500">لا توجد أدوات مضافة بعد.</p>
  ) : (
    <div class="grid gap-4 md:grid-cols-3">
      {tools.map((tool) => (
        <div class="border border-neutral-200 rounded-lg p-4 bg-white">
          <h3 class="text-lg font-bold mb-1">{tool.data.title}</h3>
          <p class="text-sm text-neutral-700 mb-3">{tool.data.excerpt}</p>
          <div class="flex items-center justify-between">
            {tool.data.pricing && (
              <span class="text-xs bg-brand/10 text-brand px-2 py-0.5 rounded">{tool.data.pricing}</span>
            )}
            {tool.data.toolUrl && (
              <a href={tool.data.toolUrl} target="_blank" rel="noopener noreferrer" class="text-xs text-brand underline">
                زيارة الموقع الرسمي
              </a>
            )}
          </div>
        </div>
      ))}
    </div>
  )}
</BaseLayout>
