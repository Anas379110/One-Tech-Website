---
import { isStale } from '../lib/content';
import type { CollectionEntry } from 'astro:content';

export interface Props {
  entry: CollectionEntry<'articles'>;
}
const { entry } = Astro.props;
const { title, category, publishDate, excerpt, editorRating } = entry.data;
const formattedDate = new Intl.DateTimeFormat('ar', { dateStyle: 'medium' }).format(publishDate);
const stale = isStale(entry);
---
<a href={`/article/${entry.slug}`} class="block border border-neutral-200 rounded-lg p-4 hover:shadow-md transition-shadow bg-white">
  <div class="flex items-center justify-between">
    <span class="text-xs text-brand font-medium">{category.replace('_', ' ')}</span>
    {stale && (
      <span class="text-xs bg-amber-100 text-amber-800 px-2 py-0.5 rounded">قد تكون المعلومة قديمة</span>
    )}
  </div>
  <h3 class="text-lg font-bold mt-1 mb-2">{title}</h3>
  <p class="text-sm text-neutral-700 mb-2">{excerpt}</p>
  <div class="flex items-center justify-between">
    <time datetime={publishDate.toISOString()} class="text-xs text-neutral-500">{formattedDate}</time>
    {editorRating && <span class="text-xs text-amber-600">{'★'.repeat(editorRating)}</span>}
  </div>
</a>
